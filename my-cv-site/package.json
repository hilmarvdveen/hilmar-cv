{
  "name": "my-cv-site",
  "version": "0.1.0",
  "private": true,
  "comment:browserslist": "Modern targets so Next/SWC stops shipping legacy polyfills (Array.prototype.at, Object.hasOwn, flat/flatMap, fromEntries, trimStart/trimEnd are all natively supported here).",
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:locales": "node scripts/crawl-locales.mjs",
    "check:structure": "node scripts/audit-structure.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:nonce": "node scripts/check-nonce.mjs",
    "check:type-scale": "node scripts/check-type-scale.mjs"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3": "^7.9.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
