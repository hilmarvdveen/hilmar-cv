# Microsoft Graph (application / client-credentials flow) — required for the
# contact, cv-download and booking API routes.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
# Mailbox the app sends mail as and creates calendar events on.
SMTP_USER=hilmar@hilmarvanderveen.com

# Enables GET /api/booking/health (stage-by-stage Graph connection diagnosis).
# Pick any long random string; requests must send it as x-diagnostics-token.
# Leave empty to keep the endpoint returning 404.
DIAGNOSTICS_TOKEN=

CRON_SECRET=

# Expiry date of the Azure client secret as shown in the app registration
# (Certificates & secrets), YYYY-MM-DD. The weekly watch cron mails a warning
# thirty and seven days before it, and asks for this date when it is empty.
MS_CLIENT_SECRET_EXPIRES_ON=

# Canonical site origin (no trailing slash). Used by robots.txt, the sitemap,
# and the SEO layer. Falls back to https://www.hilmarvanderveen.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.hilmarvanderveen.com

# Analytics (optional; only loaded in production when set).
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification token (used by the layout + SEO metadata).
GOOGLE_SITE_VERIFICATION=

# Vacancy fit check (/fit). Base URL of the agent API, without a trailing slash,
# and the bearer token the agent accepts from this site. Both empty means the
# two /api/fit routes answer "Server configuration error".
FIT_AGENT_URL=
FIT_AGENT_TOKEN=
# Budget for one agent round trip in milliseconds. Stays under the routes'
# maxDuration of 60 seconds. Defaults to 50000 when unset.
FIT_AGENT_TIMEOUT_MS=50000

# Signs the link in the mail that reopens a fit result and downloads the CV
# written to that vacancy. Pick any long random string. Without it
# POST /api/fit/cv-request, GET /api/fit/result and GET /api/fit/cv answer
# "Server configuration error".
FIT_LINK_SECRET=

# Cloudflare Turnstile on the vacancy form (optional). Only when BOTH are set
# does the widget render and do the two fit routes verify the token, and only
# then does the CSP allow challenges.cloudflare.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
